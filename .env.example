# =====================================================================
# BULK EMAIL SENDER — ENV CONFIG (FastAPI version)
# Copy this file to ".env" and fill in your real values.
# Note: SMTP servers are now managed from the WEB UI, not from .env.
# =====================================================================

# ---- Tracking server (open-tracking pixel ke liye) ----
# Yeh URL public hona chahiye. Local testing ke liye ngrok:
#   ngrok http 8000
# Then paste the ngrok URL below.
TRACKING_BASE_URL=https://your-public-domain.com

# ---- Email defaults ----
DEFAULT_REPLY_TO=support@yourdomain.com
UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe

# ---- Sending controls ----
PER_SMTP_MIN_DELAY=3      # seconds between two consecutive sends per SMTP
MAX_WORKERS=5             # parallel send threads
BATCH_SIZE=50             # how many to fetch per campaign loop tick

# ---- Server bind (uvicorn picks these up only if you wrap a launcher) ----
HOST=0.0.0.0
PORT=8000
